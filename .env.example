# ===================================================================
# JARVIS AI ASSISTANT — Environment Configuration Template
# Copy this file to .env and fill in your API keys.
# ===================================================================

# ── Primary AI Model (Groq Cloud - FREE & Ultra Fast) ───────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Live Weather API (OpenWeatherMap - FREE 1,000 calls/day) ────────
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Live News API (NewsAPI.org - FREE 100 requests/day) ─────────────
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── Optional Secondary APIs ─────────────────────────────────────────
# Hugging Face (FREE 30,000 req/month): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Ollama Local Offline LLM (Optional fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ── Server & Network Settings ───────────────────────────────────────
# Bind to 127.0.0.1 for local only, or 0.0.0.0 for LAN / phone / cloud access
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# ── Voice & Audio Settings ──────────────────────────────────────────
# Microsoft Edge-TTS Voice (e.g. en-US-ChristopherNeural, en-US-AriaNeural, en-US-GuyNeural)
JARVIS_VOICE=en-US-ChristopherNeural
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default
AUDIO_SAMPLE_RATE=16000
SILENCE_THRESHOLD=0.0020

# ── Identity & Persona ──────────────────────────────────────────────
ASSISTANT_NAME=Jarvis
ASSISTANT_WAKE_WORD=jarvis

# ── Storage & Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
MEMORY_DB_PATH=./jarvis_memory.db
MEMORY_RETENTION_DAYS=30
