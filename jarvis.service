[Unit]
Description=JARVIS AI Assistant — Quantum HUD Daemon
After=network.target sound.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/jarvis
EnvironmentFile=/opt/jarvis/.env
ExecStart=/opt/jarvis/venv/bin/python main.py --mode hud --host 0.0.0.0 --port 8000 --no-browser
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
